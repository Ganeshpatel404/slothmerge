+import re
+
+def slugify(text: str) -> str:
+    """Convert plain title into URL-safe slug."""
+    cleaned = re.sub(r'[^a-zA-Z0-9\s-]', '', text).strip()
+    return re.sub(r'[\s-]+', '-', cleaned).lower()
